# Appearance
theme = dark:Gruvbox Dark,light:Gruvbox Light
background-opacity = 0.25
background-blur = macos-glass-regular
window-padding-x = 5
window-padding-y = 5

# Cursor
mouse-hide-while-typing = true
cursor-style-blink = false

# Font
# brew install --cask font-maple-mono-normal-nf
font-size = 16
font-family = Maple Mono Normal NF

# Clipboard
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# Icon
macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = #E5DED6
macos-icon-screen-color = #E5DED6,#9C8E83

# Window
macos-titlebar-style = tabs
window-show-tab-bar = always

# macOS
macos-auto-secure-input = true
macos-secure-input-indication = true

# Quick terminal
keybind = global:cmd+u=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 50%,50%
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.1

# Notifications
desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify

# Updates
auto-update = download

# Scrolling
keybind = shift+ctrl+j=scroll_page_lines:4
keybind = shift+ctrl+k=scroll_page_lines:-4

# Tab Management
keybind = cmd+shift+h=move_tab:-1
keybind = cmd+shift+l=move_tab:1

# State
window-save-state = never

# Command Palette
## Brew
command-palette-entry = title:"Maintain Brew",description:"Update, upgrade, and clean up Homebrew",action:"text:brew update && brew upgrade && brew cleanup\n"

## Development servers
command-palette-entry = title:"Build and run npm",description:"Install, build, and run npm project",action:"text:npm ci && npm run build && npm run dev\n"
command-palette-entry = title:"Build and run pnpm",description:"Install, build, and run pnpm project",action:"text:pnpm install --frozen-lockfile && pnpm run build && pnpm run dev\n"
command-palette-entry = title:"Build and run bun",description:"Install, build, and run bun project",action:"text:bun install --frozen-lockfile && bun run build && bun run dev\n"

## Claude Code
command-palette-entry = title:"Insight Claude",description:"Open Claude Code for Insight",action:"text:cd ~/Developer/insight/ && claude -c --effort=high\n"
command-palette-entry = title:"Salvastra Claude",description:"Open Claude Code for Salvastra",action:"text:cd ~/Developer/salvastra-pi-edge/ && claude -c --effort=max\n"
command-palette-entry = title:"Xonar Customer Claude",description:"Open Claude Code for Xonar Customer",action:"text:cd ~/Developer/xonar_customer/ && claude -c --effort=high\n"

## Configs
command-palette-entry = title:"Aerospace Config",description:"Navigate to Aerospace config",action:"text:cd ~/.config/aerospace/\n"
command-palette-entry = title:"Claude Config",description:"Navigate to Claude config",action:"text:cd ~/.claude/\n"
command-palette-entry = title:"Ghostty Config",description:"Navigate to Ghostty config",action:"text:cd ~/.config/ghostty/\n"
command-palette-entry = title:"Neovim Config",description:"Navigate to Neovim config",action:"text:cd ~/.config/nvim/\n"
command-palette-entry = title:"OpenCode Config",description:"Navigate to OpenCode config",action:"text:cd ~/.config/opencode/\n"
command-palette-entry = title:"Tmux Config",description:"Navigate to tmux config",action:"text:cd ~/.config/tmux/\n"

## GitHub
command-palette-entry = title:"GitHub Auth Status",description:"Show which GitHub account is active",action:"text:gh auth status\n"
command-palette-entry = title:"rvaccone GitHub auth",description:"Switch to rvaccone GitHub auth",action:"text:gh auth switch -u rvaccone\n"
command-palette-entry = title:"rvaccone-xonar GitHub auth",description:"Switch to rvaccone-xonar GitHub auth",action:"text:gh auth switch -u rvaccone-xonar\n"

## SSH
command-palette-entry = title:"Add BitBucket SSH Key",description:"Add Xonar BitBucket key to list of identities",action:"text:ssh-add ~/.ssh/bitbucket_work\n"

## Dev
# Requires ~/.config/insight-dev/{dev.sh,Caddyfile}, which are not in this repo.
command-palette-entry = title:"Insight Dev",description:"Launch Insight backend + frontend + proxy as a tmux split in this tab",action:"text:~/.config/insight-dev/dev.sh\n"
